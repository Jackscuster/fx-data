// ============================================================================
// V5 ADDITIONS — Five new C1/C2/Exit-eligible confirmation indicators
// ============================================================================

// ----- Fisher Transform (Ehlers, S&C Sept 2002) -----
export fisher_transform(simple int length) =>
	src = hl2
	high_n = ta.highest(src, length)
	low_n  = ta.lowest(src, length)
	rng    = high_n - low_n
	raw    = rng == 0 ? 0.0 : 0.66 * ((src - low_n) / rng - 0.5)
	value = 0.0
	value := 0.67 * raw + 0.33 * nz(value[1])
	clamped = value > 0.999 ? 0.999 : value < -0.999 ? -0.999 : value
	fisher = 0.0
	fisher := 0.5 * math.log((1 + clamped) / (1 - clamped)) + 0.5 * nz(fisher[1])
	trigger = nz(fisher[1])
	[fisher, trigger]

export fisher_transform_signals(simple int length) =>
	[f, t] = fisher_transform(length)
	lt = ta.crossover(f, t)
	st = ta.crossunder(f, t)
	lc = f > t
	sc = f < t
	[lt, st, lc, sc]

export fisher_transform_exit(simple int length) =>
	[f, t] = fisher_transform(length)
	le = ta.crossunder(f, t)
	se = ta.crossover(f, t)
	[le, se]


// ----- Aroon Up/Down (Tushar Chande, 1995) -----
export aroon_updown(int length) =>
	upper = 100 * (length - ta.highestbars(high, length + 1)) / length
	lower = 100 * (length - ta.lowestbars(low, length + 1)) / length
	[upper, lower]

export aroon_signals(int length) =>
	[up, dn] = aroon_updown(length)
	lt = ta.crossover(up, dn)
	st = ta.crossunder(up, dn)
	lc = up > dn
	sc = up < dn
	[lt, st, lc, sc]

export aroon_exit(int length) =>
	[up, dn] = aroon_updown(length)
	le = ta.crossunder(up, dn)
	se = ta.crossover(up, dn)
	[le, se]


// ----- MAMA / FAMA (Ehlers, S&C V19:10, Oct 2001) -----
export mama_fama(simple float fast_limit, simple float slow_limit) =>
	src = hl2

	smooth = 0.0
	detrender = 0.0
	period = 0.0
	smoothperiod = 0.0
	i1 = 0.0
	q1 = 0.0
	jI = 0.0
	jQ = 0.0
	i2 = 0.0
	q2 = 0.0
	re_v = 0.0
	im_v = 0.0
	phase = 0.0
	deltaphase = 0.0
	alpha = 0.0
	mama = 0.0
	fama = 0.0

	if bar_index > 5
		smooth := (4 * src + 3 * nz(src[1]) + 2 * nz(src[2]) + nz(src[3])) / 10
		period_factor = 0.075 * nz(period[1]) + 0.54
		detrender := (0.0962 * smooth + 0.5769 * nz(smooth[2]) - 0.5769 * nz(smooth[4]) - 0.0962 * nz(smooth[6])) * period_factor

		q1 := (0.0962 * detrender + 0.5769 * nz(detrender[2]) - 0.5769 * nz(detrender[4]) - 0.0962 * nz(detrender[6])) * period_factor
		i1 := nz(detrender[3])

		jI := (0.0962 * i1 + 0.5769 * nz(i1[2]) - 0.5769 * nz(i1[4]) - 0.0962 * nz(i1[6])) * period_factor
		jQ := (0.0962 * q1 + 0.5769 * nz(q1[2]) - 0.5769 * nz(q1[4]) - 0.0962 * nz(q1[6])) * period_factor

		i2 := i1 - jQ
		q2 := q1 + jI
		i2 := 0.2 * i2 + 0.8 * nz(i2[1])
		q2 := 0.2 * q2 + 0.8 * nz(q2[1])

		re_v := i2 * nz(i2[1]) + q2 * nz(q2[1])
		im_v := i2 * nz(q2[1]) - q2 * nz(i2[1])
		re_v := 0.2 * re_v + 0.8 * nz(re_v[1])
		im_v := 0.2 * im_v + 0.8 * nz(im_v[1])

		if im_v != 0 and re_v != 0
			period := 2 * math.pi / math.atan(im_v / re_v)
		period := period > 1.5 * nz(period[1]) ? 1.5 * nz(period[1]) : period
		period := period < 0.67 * nz(period[1]) ? 0.67 * nz(period[1]) : period
		period := period < 6 ? 6 : period
		period := period > 50 ? 50 : period
		period := 0.2 * period + 0.8 * nz(period[1])
		smoothperiod := 0.33 * period + 0.67 * nz(smoothperiod[1])

		if i1 != 0
			phase := math.atan(q1 / i1) * 180 / math.pi
		deltaphase := nz(phase[1]) - phase
		deltaphase := deltaphase < 1 ? 1 : deltaphase

		alpha := fast_limit / deltaphase
		alpha := alpha < slow_limit ? slow_limit : alpha
		alpha := alpha > fast_limit ? fast_limit : alpha

		mama := alpha * src + (1 - alpha) * nz(mama[1])
		fama := 0.5 * alpha * mama + (1 - 0.5 * alpha) * nz(fama[1])

	[mama, fama]

export mama_fama_signals(simple float fast_limit, simple float slow_limit) =>
	[m, f] = mama_fama(fast_limit, slow_limit)
	lt = ta.crossover(m, f)
	st = ta.crossunder(m, f)
	lc = m > f
	sc = m < f
	[lt, st, lc, sc]

export mama_fama_exit(simple float fast_limit, simple float slow_limit) =>
	[m, f] = mama_fama(fast_limit, slow_limit)
	le = ta.crossunder(m, f)
	se = ta.crossover(m, f)
	[le, se]


// ----- Center of Gravity Oscillator (Ehlers, S&C May 2002) -----
export center_of_gravity(int length, simple int signal_length) =>
	src = hl2
	num = 0.0
	den = 0.0
	for i = 0 to length - 1
		num += (1 + i) * nz(src[i])
		den += nz(src[i])
	cog = den != 0 ? -num / den + (length + 1) / 2.0 : 0.0
	signal = ta.sma(cog, signal_length)
	[cog, signal]

export center_of_gravity_signals(int length, simple int signal_length) =>
	[c, s] = center_of_gravity(length, signal_length)
	lt = ta.crossover(c, s)
	st = ta.crossunder(c, s)
	lc = c > s
	sc = c < s
	[lt, st, lc, sc]

export center_of_gravity_exit(int length, simple int signal_length) =>
	[c, s] = center_of_gravity(length, signal_length)
	le = ta.crossunder(c, s)
	se = ta.crossover(c, s)
	[le, se]


// ----- Kuskus Starlight (FX-native, ~2007) -----
export kuskus_starlight(int range_periods, float price_smooth, float index_smooth) =>
	high_n = ta.highest(high, range_periods)
	low_n  = ta.lowest(low,  range_periods)
	rng    = high_n - low_n

	raw = rng == 0 ? 0.0 : (close - low_n) / rng - 0.5

	smoothed = 0.0
	smoothed := price_smooth * raw + (1 - price_smooth) * nz(smoothed[1], raw)

	clamped = smoothed > 0.499 ? 0.499 : smoothed < -0.499 ? -0.499 : smoothed
	fisher_raw = 0.5 * math.log((1 + 2 * clamped) / (1 - 2 * clamped))

	starlight = 0.0
	starlight := index_smooth * fisher_raw + (1 - index_smooth) * nz(starlight[1], fisher_raw)
	starlight

export kuskus_starlight_signals(int range_periods, float price_smooth, float index_smooth) =>
	v = kuskus_starlight(range_periods, price_smooth, index_smooth)
	lt = v[1] < 0 and v > 0
	st = v[1] > 0 and v < 0
	lc = v > 0
	sc = v < 0
	[lt, st, lc, sc]

export kuskus_starlight_exit(int range_periods, float price_smooth, float index_smooth) =>
	v = kuskus_starlight(range_periods, price_smooth, index_smooth)
	le = v[1] > 0 and v < 0
	se = v[1] < 0 and v > 0
	[le, se]


// ============================================================================
// V6 ADDITIONS — Five more C1/C2/Exit-eligible indicators (C2-leaning)
// ============================================================================

// ----- Bears Bulls Impulse (Elder Ray adaptation, Stonehill-tested 2024) -----
export bears_bulls_impulse(int length) =>
	bulls = high - ta.ema(close, length)
	bears = low  - ta.ema(close, length)
	[bulls, bears]

export bears_bulls_impulse_signals(int length) =>
	[bulls, bears] = bears_bulls_impulse(length)
	lt = bears[1] < 0 and bears > 0
	st = bulls[1] > 0 and bulls < 0
	lc = bears > 0
	sc = bulls < 0
	[lt, st, lc, sc]

export bears_bulls_impulse_exit(int length) =>
	[bulls, bears] = bears_bulls_impulse(length)
	le = bulls[1] > 0 and bulls < 0
	se = bears[1] < 0 and bears > 0
	[le, se]


// ----- FX Sniper Ergodic CCI (FX-native, Mladen ~2007) -----
export fx_sniper_ergodic_cci(int cci_length, simple int ema1_length, simple int ema2_length, int trigger_length) =>
	cci_v = ta.cci(close, cci_length)
	ema1  = ta.ema(cci_v, ema1_length)
	ema2  = ta.ema(ema1, ema2_length)
	trig  = ta.sma(ema2, trigger_length)
	[ema2, trig]

export fx_sniper_ergodic_cci_signals(int cci_length, simple int ema1_length, simple int ema2_length, int trigger_length) =>
	[main, trig] = fx_sniper_ergodic_cci(cci_length, ema1_length, ema2_length, trigger_length)
	lt = ta.crossover(main, trig)
	st = ta.crossunder(main, trig)
	lc = main > trig
	sc = main < trig
	[lt, st, lc, sc]

export fx_sniper_ergodic_cci_exit(int cci_length, simple int ema1_length, simple int ema2_length, int trigger_length) =>
	[main, trig] = fx_sniper_ergodic_cci(cci_length, ema1_length, ema2_length, trigger_length)
	le = ta.crossunder(main, trig)
	se = ta.crossover(main, trig)
	[le, se]


// ----- Lemantrend (MQL5 2009, Stonehill-tested) -----
export lemantrend(int slow_period, int medium_period, int fast_period, simple int smooth) =>
	src = close
	slow_ma = ta.ema(src, slow_period)
	med_ma  = ta.ema(src, medium_period)
	fast_ma = ta.ema(src, fast_period)

	bulls_raw = (fast_ma - med_ma) + (med_ma - slow_ma)
	bears_raw = (slow_ma - med_ma) + (med_ma - fast_ma)

	bulls = ta.ema(bulls_raw, smooth)
	bears = ta.ema(bears_raw, smooth)
	[bulls, bears]

export lemantrend_signals(int slow_period, int medium_period, int fast_period, simple int smooth) =>
	[bulls, bears] = lemantrend(slow_period, medium_period, fast_period, smooth)
	lt = ta.crossover(bulls, bears)
	st = ta.crossunder(bulls, bears)
	lc = bulls > bears
	sc = bulls < bears
	[lt, st, lc, sc]

export lemantrend_exit(int slow_period, int medium_period, int fast_period, simple int smooth) =>
	[bulls, bears] = lemantrend(slow_period, medium_period, fast_period, smooth)
	le = ta.crossunder(bulls, bears)
	se = ta.crossover(bulls, bears)
	[le, se]


// ----- Glitch Index (Stonehill-tested 2024) -----
export glitch_index(int length, float multiplier, simple int smooth) =>
	src = close
	ma_v   = ta.sma(src, length)
	dev    = ta.stdev(src, length)
	z      = dev != 0 ? (src - ma_v) / dev : 0.0
	scaled = z * multiplier
	smoothed = ta.ema(scaled, smooth)
	smoothed

export glitch_index_signals(int length, float multiplier, simple int smooth) =>
	v = glitch_index(length, multiplier, smooth)
	lt = v[1] < 0 and v > 0
	st = v[1] > 0 and v < 0
	lc = v > 0
	sc = v < 0
	[lt, st, lc, sc]

export glitch_index_exit(int length, float multiplier, simple int smooth) =>
	v = glitch_index(length, multiplier, smooth)
	le = v[1] > 0 and v < 0
	se = v[1] < 0 and v > 0
	[le, se]


// ----- Ehlers Reverse EMA (Ehlers, S&C April 2017) -----
export ehlers_reverse_ema(simple int length, float alpha) =>
	src = close
	ema_v = ta.ema(src, length)
	rema = 0.0
	rema := alpha * src + (1 - alpha) * nz(rema[1])
	[ema_v, rema]

export ehlers_reverse_ema_signals(simple int length, float alpha) =>
	[ema_v, rema] = ehlers_reverse_ema(length, alpha)
	lt = ta.crossover(rema, ema_v)
	st = ta.crossunder(rema, ema_v)
	lc = rema > ema_v
	sc = rema < ema_v
	[lt, st, lc, sc]

export ehlers_reverse_ema_exit(simple int length, float alpha) =>
	[ema_v, rema] = ehlers_reverse_ema(length, alpha)
	le = ta.crossunder(rema, ema_v)
	se = ta.crossover(rema, ema_v)
	[le, se]


// ============================================================================
// V7 ADDITIONS — Five new Volume/Volatility filters (non-directional pass-through)
// ============================================================================

// ----- Damiani Volatmeter -----
export damiani_volatmeter(simple int viscosity, simple int sedimentation, float threshold, float lag, bool use_lag) =>
	vol_atr_short = ta.atr(viscosity)
	vol_atr_long  = ta.atr(sedimentation)
	std_short     = ta.stdev(close, viscosity)
	std_long      = ta.stdev(close, sedimentation)
	vol_ratio = vol_atr_long != 0 ? vol_atr_short / vol_atr_long : 0.0
	std_ratio = std_long != 0 ? std_short / std_long : 0.0
	vmeter = use_lag ? vol_ratio - lag : vol_ratio
	tradable = vmeter > threshold
	[vmeter, threshold, tradable]

export damiani_volatmeter_volume_signals(simple int viscosity, simple int sedimentation, float threshold, float lag, bool use_lag) =>
	[vm, t, tradable] = damiani_volatmeter(viscosity, sedimentation, threshold, lag, use_lag)
	[tradable, tradable]


// ----- TTM Squeeze (John Carter) -----
export ttm_squeeze(int bb_length, float bb_mult, int kc_length, float kc_mult) =>
	src = close
	bb_basis = ta.sma(src, bb_length)
	bb_dev   = bb_mult * ta.stdev(src, bb_length)
	bb_upper = bb_basis + bb_dev
	bb_lower = bb_basis - bb_dev

	kc_basis = ta.sma(src, kc_length)
	tr_v     = ta.tr(true)
	kc_range = ta.sma(tr_v, kc_length)
	kc_upper = kc_basis + kc_mult * kc_range
	kc_lower = kc_basis - kc_mult * kc_range

	in_squeeze = bb_upper < kc_upper and bb_lower > kc_lower
	out_squeeze = not in_squeeze
	[in_squeeze, out_squeeze]

export ttm_squeeze_volume_signals(int bb_length, float bb_mult, int kc_length, float kc_mult) =>
	[in_sq, out_sq] = ttm_squeeze(bb_length, bb_mult, kc_length, kc_mult)
	[out_sq, out_sq]


// ----- Williams VIX Fix (Larry Williams, Active Trader Dec 2007) -----
export williams_vix_fix(int lookback, int bb_length, float bb_mult) =>
	wvf = ((ta.highest(close, lookback) - low) / ta.highest(close, lookback)) * 100
	bb_basis = ta.sma(wvf, bb_length)
	bb_dev   = bb_mult * ta.stdev(wvf, bb_length)
	bb_upper = bb_basis + bb_dev
	high_vol = wvf >= bb_upper
	[wvf, bb_upper, high_vol]

export williams_vix_fix_volume_signals(int lookback, int bb_length, float bb_mult) =>
	[wvf, upper, high_vol] = williams_vix_fix(lookback, bb_length, bb_mult)
	[high_vol, high_vol]


// ----- Volatility Ratio (Schwager, Technical Analysis 1995) -----
export volatility_ratio(int length) =>
	tr_v = ta.tr(true)
	tr_today = tr_v
	tr_avg   = ta.sma(tr_v, length)
	vr = tr_avg != 0 ? tr_today / tr_avg : 0.0
	expanding = vr > 1.0
	[vr, expanding]

export volatility_ratio_volume_signals(int length) =>
	[vr, expanding] = volatility_ratio(length)
	[expanding, expanding]


// ----- Mass Index (Donald Dorsey) -----
export mass_index(int length, simple int ema_length) =>
	rng = high - low
	ema1 = ta.ema(rng, ema_length)
	ema2 = ta.ema(ema1, ema_length)
	ratio = ema2 != 0 ? ema1 / ema2 : 0.0
	mi = math.sum(ratio, length)
	reversal_setup = mi > 27.0
	bulge_break    = mi > 26.5 and mi[1] >= 26.5 and ratio < 26.5
	[mi, reversal_setup or bulge_break]

export mass_index_volume_signals(int length, simple int ema_length) =>
	[mi, signal] = mass_index(length, ema_length)
	[signal, signal]


// ============================================================================
// V8 ADDITIONS — Five new Baseline moving averages (return single float)
// ============================================================================

// ----- KAMA — Kaufman Adaptive Moving Average (Perry Kaufman, 1998) -----
export kama_baseline(int length, simple int fast_length, simple int slow_length) =>
	src = close
	change = math.abs(src - src[length])
	volatility = math.sum(math.abs(src - src[1]), length)
	er = volatility != 0 ? change / volatility : 0.0
	fast_sc = 2.0 / (fast_length + 1)
	slow_sc = 2.0 / (slow_length + 1)
	sc = math.pow(er * (fast_sc - slow_sc) + slow_sc, 2)
	kama = 0.0
	kama := nz(kama[1], src) + sc * (src - nz(kama[1], src))
	kama


// ----- ALMA — Arnaud Legoux Moving Average (2009) -----
export alma_baseline(int length, simple float offset, simple float sigma) =>
	src = close
	ta.alma(src, length, offset, sigma)


// ----- T3 — Tillson Moving Average (S&C Jan 1998) -----
export t3_baseline(simple int length, simple float volume_factor) =>
	src = close
	b = volume_factor
	c1 = -b * b * b
	c2 = 3 * b * b + 3 * b * b * b
	c3 = -6 * b * b - 3 * b - 3 * b * b * b
	c4 = 1 + 3 * b + b * b * b + 3 * b * b
	e1 = ta.ema(src, length)
	e2 = ta.ema(e1, length)
	e3 = ta.ema(e2, length)
	e4 = ta.ema(e3, length)
	e5 = ta.ema(e4, length)
	e6 = ta.ema(e5, length)
	c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3


// ----- 2-Pole Super Smoother (Ehlers, Cybernetic Analysis 2004) -----
export super_smoother_2pole_baseline(simple int cutoff_period) =>
	src = close
	a1 = math.exp(-1.414 * math.pi / cutoff_period)
	b1 = 2 * a1 * math.cos(1.414 * math.pi / cutoff_period)
	c2 = b1
	c3 = -a1 * a1
	c1 = 1 - c2 - c3
	ss = 0.0
	ss := c1 * (src + nz(src[1])) / 2 + c2 * nz(ss[1]) + c3 * nz(ss[2])
	ss


// ----- FRAMA — Fractal Adaptive Moving Average (Ehlers, S&C Oct 2005) -----
export frama_baseline(simple int length) =>
	src = close
	half = length / 2

	hh1 = ta.highest(high, half)
	ll1 = ta.lowest(low,  half)
	n1  = (hh1 - ll1) / half

	hh2_raw = ta.highest(high, half)
	ll2_raw = ta.lowest(low,  half)
	hh2 = hh2_raw[half]
	ll2 = ll2_raw[half]
	n2  = (hh2 - ll2) / half

	hh3 = ta.highest(high, length)
	ll3 = ta.lowest(low,  length)
	n3  = (hh3 - ll3) / length

	d_raw = (math.log(n1 + n2) - math.log(n3)) / math.log(2)
	d = n1 > 0 and n2 > 0 and n3 > 0 ? d_raw : nz(d_raw[1])

	alpha_raw = math.exp(-4.6 * (d - 1))
	alpha = alpha_raw > 1 ? 1 : alpha_raw < 0.01 ? 0.01 : alpha_raw

	frama = 0.0
	frama := alpha * src + (1 - alpha) * nz(frama[1], src)
	frama
