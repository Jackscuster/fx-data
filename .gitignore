# HMM parameters fitted by framework.py and reused by ladder.py. Regenerated on
# demand and IS-only by construction, so it is a cache, not an input. Keeping it
# out of the repo also stops a binary blob under code/ from tripping the
# 'push to code/**' trigger in .github/workflows/update.yml.
code/hmmcache.pkl

__pycache__/
*.pyc
.DS_Store

# v7 scores are local only: pooled per-signal statistics are committed instead
# (results/signals7_stats.csv). The repo already carries 438 MB of scores6.
results/scores7/

# Task-1 selection experiment: per-pair rescores, regenerable, not a feed
results/_isonly/

# inflation.py scratch: the resume checkpoint plus the pooled accumulators, 2.2 GB
# against GitHub's 100 MB wall. What the repo carries is the three small CSVs the
# adjustment stage derives from inflation_runs.csv, which IS committed.
results/_infl_*

# rates.py raw downloads. The BoE yield-curve zip alone is 39 MB and closed
# Treasury years never change, so they are cached rather than refetched.
data/_ratecache/

# OANDA practice API token. Local only -- a credential never enters the repo.
# code/l2oanda.py reads it from here (or from the OANDA_TOKEN env var).
.oanda_token

# Gate 1 output: the 128 shard checkpoints (217 MB) and the pooled survivors
# file (224 MB), both against GitHub's 100 MB wall. Regenerable -- the shards
# ARE the resume state, and gate1_survivors.csv is only their concatenation.
# What the repo carries instead is results/gate1_summary.csv (per-slice counts
# against the measured null) and results/gate1_null_joint.csv. A 559 KB
# gate1_survivors.csv was committed at dcbeccc under the pre-slicing scheme;
# it is untracked here rather than left in place as a stale result.
results/gate1/
results/gate1_survivors.csv
results/gate1_run.log
results/gate1_nulljoint.log

# gate 1 v1 survivors, kept locally for the byte-comparison that proved the
# instrumented worker changes no trade. 216 MB, regenerable, not a feed.
results/gate1_survivors_v1.csv
results/gate1_verify.log
results/gate1_run2.log

results/superseded/
results/gate1_floor_mode*.log
results/gate1_nullfresh_modes.log
results/gate1_run3.log

results/gate1_survivors_modeC.csv

results/gate2/
results/gate2_run_*.log

results/gate2_progress_mode*.csv
results/gate2_rescoreW3.log
results/gate2_impact.log
results/gate1_nullfresh.log

results/gate2_cache/
results/gate2_rescoreW3_full.log
results/ci_pinned_validation.log
results/superseded/

results/crisis_all/
results/crisis_all.log
results/ci_validation_state.txt
data/oanda_h1/

# ALLPASS mark caches: 10 MB each, rebuilt in ~3 min by l2allpass.py --stage build
results/allpass_marks.pkl
results/allpass_holdout_marks.pkl

# walk-forward engine caches: 210 MB, rebuilt by l2walkfwd.py --stage engine (32 min)
results/wf_marks*.pkl
results/wf_trades*.pkl

# random-entry null unit-scale cache, rebuilt by the parent of --stage nullre
results/wf_randk*.pkl

# clean-field chain scratch: dry-run outputs (--limit) and live pidfiles
results/*_cleanfield_dry*
results/gate2_cleanfield_dry*.csv
results/chain_pids/

# routing permission tables and the direction-null symlinks: regenerable from l2route / l2returns
results/route_*.pkl
results/wf_*_dirnull.pkl

# H.10 score batches archived at the 14 Sep swap; regenerable
results/scores_h10_archive/
code/__pycache__/

# THE _r2 GATE 1 BANKS (HANDOFF 0l). Engine output, rebuilt from code in
# minutes for A and B and 77 min for C, and mode C's is 4 GB -- exactly the
# kind of thing results/gate1/ is already ignored for. On 16 Nov a chain
# committed the mode C bank (6.5 GB) and GitHub rejected the push; the repo
# carries the CURVES and the rank correlations, which is what anyone reads.
results/r2gate1/

# Gate 3's passers'-book part files and the sampled nulls' scratch: both are
# RESUME STATE, not feeds. The book parts hold the four per-(pair, day) sums
# plus the ids already folded in, and the whole mode A book rebuilds from the
# bank in 1.5 min measured; the null parts are deleted by the stage itself once
# a step is summed. Committing them put 851 MB per mode into a .git that is
# already 5.9 GB, on a volume with 8 GB free -- the chain would have filled the
# disk before it finished. What IS committed is what they produce:
# mode<M>_gate3_passersbook.csv, its _nulls.csv, the g3pass daily series and
# the pass mask. The KPI bank (mode<M>_gate3parts) stays tracked: that one is a
# feed, 6.7 h of scoring that nothing else can reproduce cheaply.
results/r2gate2/*_gate3bookparts/
results/r2gate2/*_nullparts_*/
