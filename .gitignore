# HMM parameters fitted by framework.py and reused by ladder.py. Regenerated on
# demand and IS-only by construction, so it is a cache, not an input. Keeping it
# out of the repo also stops a binary blob under code/ from tripping the
# 'push to code/**' trigger in .github/workflows/update.yml.
code/hmmcache.pkl

__pycache__/
*.pyc
.DS_Store

# v7 scores are local only: pooled per-signal statistics are committed instead
# (results/signals7_stats.csv). The repo already carries 438 MB of scores6.
results/scores7/

# Task-1 selection experiment: per-pair rescores, regenerable, not a feed
results/_isonly/

# inflation.py scratch: the resume checkpoint plus the pooled accumulators, 2.2 GB
# against GitHub's 100 MB wall. What the repo carries is the three small CSVs the
# adjustment stage derives from inflation_runs.csv, which IS committed.
results/_infl_*

# rates.py raw downloads. The BoE yield-curve zip alone is 39 MB and closed
# Treasury years never change, so they are cached rather than refetched.
data/_ratecache/

# OANDA practice API token. Local only -- a credential never enters the repo.
# code/l2oanda.py reads it from here (or from the OANDA_TOKEN env var).
.oanda_token

# Gate 1 output: the 128 shard checkpoints (217 MB) and the pooled survivors
# file (224 MB), both against GitHub's 100 MB wall. Regenerable -- the shards
# ARE the resume state, and gate1_survivors.csv is only their concatenation.
# What the repo carries instead is results/gate1_summary.csv (per-slice counts
# against the measured null) and results/gate1_null_joint.csv. A 559 KB
# gate1_survivors.csv was committed at dcbeccc under the pre-slicing scheme;
# it is untracked here rather than left in place as a stale result.
results/gate1/
results/gate1_survivors.csv
results/gate1_run.log
results/gate1_nulljoint.log

# gate 1 v1 survivors, kept locally for the byte-comparison that proved the
# instrumented worker changes no trade. 216 MB, regenerable, not a feed.
results/gate1_survivors_v1.csv
results/gate1_verify.log
results/gate1_run2.log

results/superseded/
results/gate1_floor_mode*.log
results/gate1_nullfresh_modes.log
results/gate1_run3.log

results/gate1_survivors_modeC.csv
