// ----- [C1] Detrended Price Oscillator -----
dpo_c1_len = input.int(50, title="Detrended Price Oscillator: Length", group="[C1] Detrended Price Oscillator", active=(IND_1_SLCT == "Detrended Price Oscillator"))
dpo_c1_cent = input.bool(false, title="Detrended Price Oscillator: Centered?", group="[C1] Detrended Price Oscillator", active=(IND_1_SLCT == "Detrended Price Oscillator"))

// ----- [C1] Detrended Synthetic Price Oscillator -----
dspo_c1_len = input.int(14, title="Detrended Synthetic Price Oscillator: Length", group="[C1] Detrended Synthetic Price Oscillator", active=(IND_1_SLCT == "Detrended Synthetic Price Oscillator"))

// ----- [C1] DiDi Index -----
didi_c1_med = input.int(8, title="DiDi Index: Medium Value", group="[C1] DiDi Index", active=(IND_1_SLCT == "DiDi Index"))
