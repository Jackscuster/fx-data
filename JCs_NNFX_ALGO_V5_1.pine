ce_c1_close = input.bool(true, title="Chandelier Exit: Use Close Price for Extremums?", group="[C1] Chandelier Exit", active=(IND_1_SLCT == "Chandelier Exit"))

// ----- [C1] Coppock Curve -----
cc_c1_smooth = input.int(10, title="Coppock Curve: Smoothing Length", group="[C1] Coppock Curve", active=(IND_1_SLCT == "Coppock Curve"))
