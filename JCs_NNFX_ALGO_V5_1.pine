// ----- [C1] Glitch Index -----
gli_c1_len = input.int(30, title="Glitch Index: Length", group="[C1] Glitch Index", active=(IND_1_SLCT == "Glitch Index"))
gli_c1_mult = input.float(5.0, title="Glitch Index: Multiplier", group="[C1] Glitch Index", active=(IND_1_SLCT == "Glitch Index"))
gli_c1_smooth = input.int(3, title="Glitch Index: Smoothing", group="[C1] Glitch Index", active=(IND_1_SLCT == "Glitch Index"))

// ----- [C1] Half Trend -----
ht_c1_amp = input.int(50, title="Half Trend: Amplitude", group="[C1] Half Trend", active=(IND_1_SLCT == "Half Trend"))

// ----- [C1] Heiken Ashi Smoothed -----
ha_c1_t1 = input.string(defval="T3", title="HeikenAshi Smoothed: Type of first moving average", options=["TRIMA","VIDYA","FAMA","AMA","HMA","TEMA","SMMA","WMA","EMA","SMA","T3","DEMA","ALMA","LSMA"], group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
