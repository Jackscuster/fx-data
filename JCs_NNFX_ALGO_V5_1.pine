ha_c1_vf1 = input.float(0.82, title="HeikenAshi Smoothed: Volume Factor of T3 for 1st Moving Average", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_ao1 = input.float(0.85, title="HiekenAshi Smoothed: Offset of Arnaud Legoux Moving Average type 1", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_as1 = input.int(6, title="HeikenAshi Smoothed: Sigma of Arnaud Legoux Moving Average type 1", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_ls1 = input.int(0, title="HeikenAshi Smoothed: Least Squares Moving Average offset as type 1", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_am1 = input.float(0.181, title="HeikenAshi Smoothed: Smooth Constant of AMA as Type 1", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_fr1a = input.int(1, title="HeikenAshi Smoothed: FRAMA as type 1", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_fr1b = input.int(168, title="HeikenAshi Smoothed: FRAMA as type 1(input 2)", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_vf2 = input.float(0.82, title="HeikenAshi Smoothed: Volume Factor of T3 for 2nd Moving Average", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_ao2 = input.float(0.85, title="HiekenAshi Smoothed: Offset of Arnaud Legoux Moving Average type 2", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_as2 = input.int(6, title="HeikenAshi Smoothed: Sigma of Arnaud Legoux Moving Average type 2", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_ls2 = input.int(0, title="HeikenAshi Smoothed: Least Squares Moving Average offset as type 2", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_am2 = input.float(0.181, title="HeikenAshi Smoothed: Smooth Constant of AMA as Type 2", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_fr2a = input.int(1, title="HeikenAshi Smoothed: FRAMA as type 2", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_fr2b = input.int(168, title="HeikenAshi Smoothed: FRAMA as type 2(input 2)", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))

// ----- [C1] J_TPO -----
jtpo_c1_len = input.int(40, title="J_TPO: Length", group="[C1] J_TPO", active=(IND_1_SLCT == "J_TPO"))
jtpo_c1_emaL = input.int(200, title="J_TPO: EMA Length", group="[C1] J_TPO", active=(IND_1_SLCT == "J_TPO"))
jtpo_c1_emaF = input.bool(false, title="Will filter trade signals based on ema on J_TPO", group="[C1] J_TPO", active=(IND_1_SLCT == "J_TPO"))

// ----- [C1] Kallman Filter -----
kf_c1_sharp = input.float(1.0, title="Kalman Filter: Sharpness", group="[C1] Kallman Filter", active=(IND_1_SLCT == "Kallman Filter"))
kf_c1_k = input.float(1.0, title="Kalman Filter: K", group="[C1] Kallman Filter", active=(IND_1_SLCT == "Kallman Filter"))

// ----- [C1] Kase Peak Oscillator -----
kpo_c1_short = input.int(8, title="Kase Peak Oscillator: Short Cycle", group="[C1] Kase Peak Oscillator", active=(IND_1_SLCT == "Kase Peak Oscillator"))
kpo_c1_long = input.int(65, title="Kase Peak Oscillator: Long Cycle", group="[C1] Kase Peak Oscillator", active=(IND_1_SLCT == "Kase Peak Oscillator"))
