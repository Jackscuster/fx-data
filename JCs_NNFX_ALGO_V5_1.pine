//@version=6
strategy("JC's NNFX ALGO {Backtesting Suite} V5.1", overlay=true, currency=currency.USD, pyramiding=2, calc_on_every_tick=false, margin_long=0, margin_short=0)

// V5 — EXIT LOGIC OVERHAUL
//   - Dropdown reduced from 4 options to 3: "Static", "Static / Exit IND", "NNFX Phased"
//   - Default Exit Type changed from "Static / Exit IND" to "NNFX Phased"
//   - "Trail SL" and "Trail S/L / Exit IND" removed (rolled into NNFX Phased)
//   - 'breakeven' user toggle removed; breakeven is hardcoded into "Static / Exit IND"
//     and is part of NNFX Phased's Phase 2 by design
//   - Starting balance default changed from $1,000,000 to $100,000
//
// NNFX Phased — Leg 2 trade management (long-side example; short mirrors):
//   Phase 1 (entry → Leg 1 TP hits): SL at entry − atrMulti_Loss × ATR (fixed, no TP)
//   Phase 2 (Leg 1 TP fills → price reaches 2× ATR profit from entry): SL at entry (breakeven)
//   Phase 3 (price hits 2× ATR profit → close): trailing SL at 1.5 × ATR below highest close
//     since Phase 3 activated
// Leg 1 always: SL at atrMulti_Loss × ATR, TP at atrMulti_Loss × RR × ATR. Exit ind (C1 flip
//   or Slot 5) can also close it.
//
// Phase activation is per-trade, latched in `var` state. Phase 3's "highest close since
// activation" tracker resets on each new entry. Trail activation uses raw ATR multiples
// (2× and 1.5×), independent of atrMulti_Loss setting, per design call.
//
// V3.2 base preserved otherwise. All indicator slot wiring, library calls, BTF/OCR/ATR
// nuance rules, and stats tables unchanged.
//
// V5.1 — UI / SETTINGS PANEL CLEANUP
//   - Per-indicator inputs reorganized by slot, alphabetical within slot:
//     [C1] (A→Z), [C2] (A→Z), [V] (A→Z), [EX] (A→Z).
//   - Group labels prefixed with slot tags ([C1], [C2], [V], [EX]) so the
//     TradingView Settings panel keeps each slot's indicators visually clustered.
//   - Every per-indicator input is gated with active=(<selector> == "<name>").
//     Non-selected indicators show greyed-out, unclickable inputs. Only the
//     currently selected indicator in each slot is editable.
//   - Baseline inputs unchanged in V5.1 — they were already conditional via
//     if-blocks in the BASELINE section downstream, so they already only render
//     for the selected baseline.
//   - No logic, variable name, library call, or signal-routing changes vs V5.
//     V5.1 should produce identical trades to V5 on the same settings.

// V8.1 library import — uses jacktime/JCs_Indicators_and_Functions_Lib (Pine v6)
// UPDATE THE /2 BELOW to the new version number TradingView assigns when you
// republish the library.
import jacktime/JCs_Indicators_and_Functions_Lib/2 as jcif

// ============================================================
// CHART AND BACKTEST SETTINGS
// ============================================================
chrtMode = "Chart Mode"
ChartMode = input.string(title="Chart Settings", defval="Live Trading", options=["Live Trading", "Backtesting"], group=chrtMode)

Gchart = "Chart Settings"
drawtester    = input.bool(title="Draw Backtest Stats Table ", defval=true, group=Gchart)
title_Plot    = input.bool(title="Algorithm Settings Table ",  defval=true, group=Gchart)
P_ltc         = input.bool(title="Live Trading Chart Plot",    defval=true, group=Gchart)
color_theme1  = input.color(title="Chart Border Color",        defval=color.rgb(255, 60, 0), group=Gchart)
Text_color1   = input.color(title="Chart Text Color",          defval=color.white, group=Gchart)
BckGRnd_color1= input.color(title="Chart Background Color",    defval=color.rgb(0, 0, 0), group=Gchart)

bcktstSettings = "Backtest Settings"
startDate  = input.int(title='Start Date',  defval=1,    minval=1, maxval=31, group=bcktstSettings)
startMonth = input.int(title='Start Month', defval=1,    minval=1, maxval=12, group=bcktstSettings)
startYear  = input.int(title='Start Year',  defval=1900, minval=1800, maxval=2100, group=bcktstSettings)
endDate    = input.int(title='End Date',    defval=1,    minval=1, maxval=31, group=bcktstSettings)
endMonth   = input.int(title='End Month',   defval=1,    minval=1, maxval=12, group=bcktstSettings)
endYear    = input.int(title='End Year',    defval=2100, minval=1800, maxval=2100, group=bcktstSettings)

inDateRange = time >= timestamp(syminfo.timezone, startYear, startMonth, startDate, 0, 0) and time < timestamp(syminfo.timezone, endYear, endMonth, endDate, 0, 0)
dateWindow() => inDateRange

// V5: starting balance default 100k (was 1M)
startBalance    = input.float(title="Account Starting Balance", defval=100000, group=bcktstSettings)
compoundProfits = input.bool(title="Compound Profits (size off live balance)", defval=true, group=bcktstSettings, tooltip="When ON, position size grows/shrinks with strategy P&L. When OFF, every trade sizes off the starting balance.")

G_Alerts = "Alert Messages"
l_AlertMSG = input.string(title="Alert for Long Entry",  defval="Enter Long Trade on:",  group=G_Alerts)
s_AlertMSG = input.string(title="Alert for Short Entry", defval="Enter Short Trade on:", group=G_Alerts)
e_AlertMSG = input.string(title="Alert for Trade Exit",  defval="Close Open Positions on:", group=G_Alerts)

// ============================================================
// RISK MANAGEMENT
// ============================================================
// V5: 'breakeven' input removed. Behavior is now hardcoded where it applies.
riskManagment     = "Risk Management"
fixedpositionsize = input.bool(title="Fixed position size",                       defval=false,  group=riskManagment)
dollarsPC         = input.float(title="Dollars per contract For Fixed Position Size", defval=100000, group=riskManagment)
contracts         = input.float(title="Fixed Position Size Contracts",            defval=1,      group=riskManagment)
doubletrades      = input.bool(title="Double Position Trade",                     defval=true,   group=riskManagment)
shortrades        = input.bool(title="Take Short Trades?",                        defval=true,   group=riskManagment)
iMainindExit      = input.bool(title="Exit Trade When Main Confirmation Ind flips", defval=false, group=riskManagment)
inputRisk         = input.float(title="Default Risk Per Trade %",                 defval=2.0, minval=0.001, group=riskManagment)
percentRisk       = inputRisk / 100

atrLength      = input.int(title="ATR Length",        defval=14,  group=riskManagment)
RR             = input.float(title="Risk to Reward Ratio", defval=1.5, group=riskManagment)
atrMulti_Loss  = input.float(title="ATR Loss Multiple",   defval=1.0, group=riskManagment)
atrMulti_Profit = atrMulti_Loss * RR
atr             = ta.atr(atrLength)

// V5: Exit Type dropdown reduced and reordered. Default = "NNFX Phased".
Exit_Type = input.string(defval="NNFX Phased", title="Exit Condition Type", options=["Static", "Static / Exit IND", "NNFX Phased"], group=riskManagment)

truncate(number, decimals) =>
    factor = math.pow(10, decimals)
    int(number * factor) / factor

// ============================================================
// INDICATOR SLOT SELECTORS AND TOGGLES
// ============================================================
INDI1 = "Indicator 1 (Main Confirmation Indicator)"
Ind_1_Check_Trig = input.bool(true, title="Main Confirmation Indicator - Trigger", group=INDI1, inline="1")
Ind_1_Check_Conf = input.bool(true, title="Main Confirmation Indicator - Confirmation", group=INDI1, inline="1")
IND_1_SLCT = input.string(title="Main Confirmation Indicator", defval="SSL Channel",
  options=["Chaikin Money Flow", "Chandelier Exit", "Coppock Curve", "Coral", "DiDi Index", "Detrended Price Oscillator", "Detrended Synthetic Price Oscillator",
   "Ease Of Movement", "Half Trend", "Heiken Ashi Smoothed", "J_TPO", "Kallman Filter", "Kase Peak Oscillator", "Laguerre Filter", "Price Momentum Oscillator",
   "Polychrmatic Momentum", "QQE Mod", "Relative Vigor Index", "Rex Oscillator", "Schaff Trend Cycle", "SSL Channel", "Supertrend", "Trend Direction Force Index",
   "Volatility Quality", "Vortex Indicator", "Waddah Attar Explosion",
   "Fisher Transform", "Aroon", "MAMA FAMA", "Center of Gravity", "Kuskus Starlight",
   "Bears Bulls Impulse", "FX Sniper Ergodic CCI", "Lemantrend", "Glitch Index", "Ehlers Reverse EMA"], group=INDI1)

INDI2 = "Indicator 2 (Second Confirmation Indicator)"
Ind_2_Check_Conf = input.bool(true, title="Second Confirmation Indicator - Confirmation", group=INDI2)
IND_2_SLCT = input.string(title="Second Confirmation Indicator", defval="Detrended Synthetic Price Oscillator",
  options=["Chaikin Money Flow", "Chandelier Exit", "Coppock Curve", "Coral", "DiDi Index", "Detrended Price Oscillator", "Detrended Synthetic Price Oscillator",
   "Ease Of Movement", "Half Trend", "Heiken Ashi Smoothed", "J_TPO", "Kallman Filter", "Kase Peak Oscillator", "Laguerre Filter", "Price Momentum Oscillator",
   "Polychrmatic Momentum", "QQE Mod", "Relative Vigor Index", "Rex Oscillator", "Schaff Trend Cycle", "SSL Channel", "Supertrend", "Trend Direction Force Index",
   "Volatility Quality", "Vortex Indicator", "Waddah Attar Explosion",
   "Fisher Transform", "Aroon", "MAMA FAMA", "Center of Gravity", "Kuskus Starlight",
   "Bears Bulls Impulse", "FX Sniper Ergodic CCI", "Lemantrend", "Glitch Index", "Ehlers Reverse EMA"], group=INDI2)

INDI3 = "Volume Indicator"
Ind_3_Check_Conf = input(true, title="Indicator 3 (Volume Indicator)", group=INDI3)
IND_3_SLCT = input.string(title="Volume Indicator", defval="Variance",
  options=["Chaikin Oscillator", "Chaikin Volatility", "Elders Force Index", "Normalized Volume", "Variance", "Volume Zone Oscilator", "Waddah Attar Explosion",
   "Damiani Volatmeter", "TTM Squeeze", "Williams VIX Fix", "Volatility Ratio", "Mass Index"])

INDI4 = "Baseline"
Ind_4_Check_Conf = input(true, title="Baseline: Confirmation", group=INDI4)
Ind_4_Check_Trig = input(true, title="Baseline: Trigger",      group=INDI4)
maType = input.string(title="Baseline", defval="Triangular Moving Average",
  options=["EMA", "HMA", "Fantail VMA", "McGinley Dynamic Index", "RMA", "Triangular Moving Average", "VIDYA", "VWMA", "WMA",
   "KAMA", "ALMA", "T3 Tillson", "Super Smoother 2-Pole", "FRAMA"], group=INDI4)

INDI6 = "Continuation Trades"
Ind_6_Check = input(true, title="Indicator 6 - Continuation Trades", group=INDI6)

INDI5 = "Exit Indicator"
Ind_5_Check_Exit  = input(true, title="Indicator 5 - Exit", group=INDI5)
IND_5_SLCT = input.string(title="Exit Indicator", defval="SSL Channel",
  options=["Chaikin Money Flow", "Chandelier Exit", "Coppock Curve", "Coral", "DiDi Index", "Detrended Price Oscillator", "Detrended Synthetic Price Oscillator",
   "Ease Of Movement", "Half Trend", "Heiken Ashi Smoothed", "J_TPO", "Kallman Filter", "Kase Peak Oscillator", "Laguerre Filter", "Price Momentum Oscillator",
   "Polychrmatic Momentum", "QQE Mod", "Relative Vigor Index", "Rex Oscillator", "Schaff Trend Cycle", "SSL Channel", "Supertrend", "Trend Direction Force Index",
   "Volatility Quality", "Vortex Indicator", "Waddah Attar Explosion",
   "Fisher Transform", "Aroon", "MAMA FAMA", "Center of Gravity", "Kuskus Starlight",
   "Bears Bulls Impulse", "FX Sniper Ergodic CCI", "Lemantrend", "Glitch Index", "Ehlers Reverse EMA"], group=INDI5)
Ind_4_Check_Exit  = input(true, title="Baseline - Exit", group=INDI5)

ENTRY_GROUP = "Entry Conditions"
useBaselineEntry     = input.bool(true, title="Enable Baseline-Cross Entry (longcondition1)", group=ENTRY_GROUP)
useC1Entry           = input.bool(true, title="Enable C1-Trigger Entry (longcondition2)",     group=ENTRY_GROUP)
useContinuationEntry = input.bool(true, title="Enable Continuation Entry (longcondition3)",   group=ENTRY_GROUP)

NAU = "Nuances"
NAU_OCR_Check_Conf = input(false, title="One Candle Rule",        group=NAU)
NAU_ATR_Check_Conf = input(true,  title="1X Atr Rule",            group=NAU)
ATR_VAR             = input(title="Baseline ATR Rule", defval=1.5, group=NAU)
NAU_BTF_Check_Conf = input(true,  title="Bridge Too Far",         group=NAU)
BTF_VAR             = input(title="Bridge Too Far Variable", defval=7, group=NAU)


// ============================================================
// V5.1 — REORGANIZED INPUT BLOCK
// ============================================================
// Order: C1 A->Z, C2 A->Z, V A->Z, EX A->Z
// Every input gates with active=(<selector> == "<name>"). Non-selected
// indicators show greyed-out, unmovable inputs. Group labels prefixed
// [C1], [C2], [V], [EX] so TradingView's settings panel keeps slot
// clusters visually grouped.
// Baseline inputs remain in their original if-block downstream — they're
// already conditional and only render when their maType matches.

// ----- Heiken Ashi Smoothed: shared HA candle data (used by all 3 slot instances) -----
HA_open  = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, open)
HA_high  = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, high)
HA_low   = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, low)
HA_close = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close)

// ============================================================
// [C1] PER-INDICATOR INPUTS (alphabetical, active=gated)
// ============================================================

// ----- [C1] Aroon -----
aroon_c1_len = input.int(25, title="Aroon: Length", group="[C1] Aroon", active=(IND_1_SLCT == "Aroon"))

// ----- [C1] Bears Bulls Impulse -----
bbi_c1_len = input.int(13, title="Bears Bulls Impulse: Length", group="[C1] Bears Bulls Impulse", active=(IND_1_SLCT == "Bears Bulls Impulse"))

// ----- [C1] Center of Gravity -----
cog_c1_len = input.int(10, title="Center of Gravity: Length", group="[C1] Center of Gravity", active=(IND_1_SLCT == "Center of Gravity"))
cog_c1_sig = input.int(3, title="Center of Gravity: Signal Length", group="[C1] Center of Gravity", active=(IND_1_SLCT == "Center of Gravity"))

// ----- [C1] Chaikin Money Flow -----
cmf_c1_lookback = input.int(50, title="Chaikin Money Flow: Length", group="[C1] Chaikin Money Flow", active=(IND_1_SLCT == "Chaikin Money Flow"))

// ----- [C1] Chandelier Exit -----
ce_c1_atr = input.int(22, title="Chandelier Exit: ATR period", group="[C1] Chandelier Exit", active=(IND_1_SLCT == "Chandelier Exit"))
