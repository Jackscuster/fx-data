fxs_c1_cci = input.int(14, title="FX Sniper Ergodic: CCI Period", group="[C1] FX Sniper Ergodic CCI", active=(IND_1_SLCT == "FX Sniper Ergodic CCI"))
fxs_c1_p1 = input.int(5, title="FX Sniper Ergodic: 1st EMA Period", group="[C1] FX Sniper Ergodic CCI", active=(IND_1_SLCT == "FX Sniper Ergodic CCI"))
