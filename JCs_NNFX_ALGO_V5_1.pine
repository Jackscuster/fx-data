else if IND_2_SLCT == "Bears Bulls Impulse"
    Ind_2_L_Conf := c2_lc_bbi
    Ind_2_S_Conf := c2_sc_bbi
else if IND_2_SLCT == "FX Sniper Ergodic CCI"
    Ind_2_L_Conf := c2_lc_fxs
    Ind_2_S_Conf := c2_sc_fxs
else if IND_2_SLCT == "Lemantrend"
    Ind_2_L_Conf := c2_lc_lmt
    Ind_2_S_Conf := c2_sc_lmt
else if IND_2_SLCT == "Glitch Index"
    Ind_2_L_Conf := c2_lc_gli
    Ind_2_S_Conf := c2_sc_gli
else if IND_2_SLCT == "Ehlers Reverse EMA"
    Ind_2_L_Conf := c2_lc_ere
    Ind_2_S_Conf := c2_sc_ere

if not Ind_2_Check_Conf
    Ind_2_L_Conf := true
    Ind_2_S_Conf := true

// ----- Volume Slot: helper calls -----
[v_lc_co,  v_sc_co ] = jcif.chaikin_oscillator_volume_signals(co_v_fast, co_v_slow)
[v_lc_cv,  v_sc_cv ] = jcif.chaikin_volatility_volume_signals(cv_v_cvi, cv_v_roc)
[v_lc_efi, v_sc_efi] = jcif.elders_force_index_volume_signals(efi_v_len)
[v_lc_nv,  v_sc_nv ] = jcif.normalized_volume_volume_signals(nv_v_len)
[v_lc_var, v_sc_var] = jcif.variance_volume_signals(var_v_mode, var_v_hl, var_v_method, var_v_lb, var_v_filtLb, var_v_emaLen)
[v_lc_vzo, v_sc_vzo] = jcif.volume_zone_oscillator_volume_signals(vzo_v_len, vzo_v_sm, vzo_v_smLen, vzo_v_nz)
[v_lc_wa,  v_sc_wa ] = jcif.waddah_attar_explosion_volume_signals(wae_v_sens, wae_v_fast, wae_v_slow, wae_v_bbL, wae_v_bbS)
[v_lc_dam, v_sc_dam] = jcif.damiani_volatmeter_volume_signals(dam_visc, dam_sed, dam_thresh, dam_lag, dam_uselag)
[v_lc_ttm, v_sc_ttm] = jcif.ttm_squeeze_volume_signals(ttm_bb_len, ttm_bb_mult, ttm_kc_len, ttm_kc_mult)
[v_lc_wvf, v_sc_wvf] = jcif.williams_vix_fix_volume_signals(wvf_lookback, wvf_bb_len, wvf_bb_mult)
[v_lc_vr,  v_sc_vr ] = jcif.volatility_ratio_volume_signals(vr_length)
[v_lc_mi,  v_sc_mi ] = jcif.mass_index_volume_signals(mi_length, mi_ema_len)

// ----- Volume Slot: dispatch -----
if IND_3_SLCT == "Chaikin Oscillator"
    Ind_3_L_Conf := v_lc_co
    Ind_3_S_Conf := v_sc_co
else if IND_3_SLCT == "Chaikin Volatility"
    Ind_3_L_Conf := v_lc_cv
    Ind_3_S_Conf := v_sc_cv
else if IND_3_SLCT == "Elders Force Index"
    Ind_3_L_Conf := v_lc_efi
    Ind_3_S_Conf := v_sc_efi
else if IND_3_SLCT == "Normalized Volume"
    Ind_3_L_Conf := v_lc_nv
    Ind_3_S_Conf := v_sc_nv
else if IND_3_SLCT == "Variance"
    Ind_3_L_Conf := v_lc_var
    Ind_3_S_Conf := v_sc_var
else if IND_3_SLCT == "Volume Zone Oscilator"
    Ind_3_L_Conf := v_lc_vzo
    Ind_3_S_Conf := v_sc_vzo
else if IND_3_SLCT == "Waddah Attar Explosion"
    Ind_3_L_Conf := v_lc_wa
    Ind_3_S_Conf := v_sc_wa
else if IND_3_SLCT == "Damiani Volatmeter"
    Ind_3_L_Conf := v_lc_dam
    Ind_3_S_Conf := v_sc_dam
else if IND_3_SLCT == "TTM Squeeze"
    Ind_3_L_Conf := v_lc_ttm
    Ind_3_S_Conf := v_sc_ttm
else if IND_3_SLCT == "Williams VIX Fix"
    Ind_3_L_Conf := v_lc_wvf
    Ind_3_S_Conf := v_sc_wvf
else if IND_3_SLCT == "Volatility Ratio"
    Ind_3_L_Conf := v_lc_vr
    Ind_3_S_Conf := v_sc_vr
else if IND_3_SLCT == "Mass Index"
    Ind_3_L_Conf := v_lc_mi
    Ind_3_S_Conf := v_sc_mi

if not Ind_3_Check_Conf
    Ind_3_L_Conf := true
    Ind_3_S_Conf := true

// ----- Exit Slot: helper calls -----
[ex_le_cmf, ex_se_cmf] = jcif.chaikin_money_flow_exit(cmf_ex_lookback)
[ex_le_ce,  ex_se_ce ] = jcif.chandelier_exit_exit(ce_ex_atr, ce_ex_mult, ce_ex_close)
[ex_le_cc,  ex_se_cc ] = jcif.coppock_curve_exit(cc_ex_smooth, cc_ex_longROC, cc_ex_shortROC)
[ex_le_co,  ex_se_co ] = jcif.coral_exit(coral_ex_smooth, coral_ex_d)
[ex_le_di,  ex_se_di ] = jcif.didi_index_exit(didi_ex_med, didi_ex_long)
[ex_le_dp,  ex_se_dp ] = jcif.dpo_exit(dpo_ex_len, dpo_ex_cent)
[ex_le_ds,  ex_se_ds ] = jcif.dspo_exit(dspo_ex_len)
[ex_le_eo,  ex_se_eo ] = jcif.ease_of_movement_exit(eom_ex_len, eom_ex_div)
[ex_le_ht,  ex_se_ht ] = jcif.halftrend_exit(ht_ex_amp)
[ex_le_ha,  ex_se_ha ] = jcif.hieken_ashi_smoothed_exit(HA_open, HA_high, HA_low, HA_close, ha_ex_t1, ha_ex_l1, ha_ex_t2, ha_ex_l2, ha_ex_ss, ha_ex_vf1, ha_ex_ao1, ha_ex_as1, ha_ex_ls1, ha_ex_am1, ha_ex_fr1a, ha_ex_fr1b, ha_ex_vf2, ha_ex_ao2, ha_ex_as2, ha_ex_ls2, ha_ex_am2, ha_ex_fr2a, ha_ex_fr2b)
[ex_le_jt,  ex_se_jt ] = jcif.j_tpo_exit(jtpo_ex_len, jtpo_ex_emaL, jtpo_ex_emaF)
[ex_le_kf,  ex_se_kf ] = jcif.kalman_filter_exit(kf_ex_sharp, kf_ex_k)
[ex_le_kp,  ex_se_kp ] = jcif.kase_peak_oscillator_exit(kpo_ex_short, kpo_ex_long, kpo_ex_sharp)
[ex_le_lf,  ex_se_lf ] = jcif.laguerre_filter_exit(lf_ex_alpha)
[ex_le_pmo, ex_se_pmo] = jcif.price_momentum_oscillator_exit(pmo_ex_s1, pmo_ex_s2, pmo_ex_sg)
[ex_le_pm,  ex_se_pm ] = jcif.polychromatic_momentum_exit(poly_ex_len)
[ex_le_qq,  ex_se_qq ] = jcif.qqe_mod_exit(qqe_ex_rsiP, qqe_ex_rsiL, qqe_ex_fac)
[ex_le_rv,  ex_se_rv ] = jcif.relative_vigor_index_exit(rvi_ex_len)
[ex_le_rx,  ex_se_rx ] = jcif.rex_oscillator_exit(rex_ex_t1, rex_ex_l1, rex_ex_ao1, rex_ex_as1, rex_ex_ff1, rex_ex_fs1, rex_ex_jp1, rex_ex_jpw1, rex_ex_ls1, rex_ex_mf1, rex_ex_mfb1, rex_ex_mfw1, rex_ex_va1, rex_ex_t2, rex_ex_l2, rex_ex_ao2, rex_ex_as2, rex_ex_ff2, rex_ex_fs2, rex_ex_jp2, rex_ex_jpw2, rex_ex_ls2, rex_ex_mf2, rex_ex_mfb2, rex_ex_mfw2, rex_ex_va2)
[ex_le_st,  ex_se_st ] = jcif.schaff_trend_cycle_exit(stc_ex_macdF, stc_ex_macdS, stc_ex_cyc, stc_ex_d1, stc_ex_d2, stc_ex_up, stc_ex_lo)
[ex_le_ss,  ex_se_ss ] = jcif.ssl_channel_exit(ssl_ex_len)
[ex_le_su,  ex_se_su ] = jcif.supertrend_exit(st_ex_fac, st_ex_atr)
[ex_le_td,  ex_se_td ] = jcif.trend_direction_force_index_exit(tdfi_ex_lb, tdfi_ex_fh, tdfi_ex_fl)
[ex_le_vq,  ex_se_vq ] = jcif.volatility_quality_exit(vq_ex_ma, vq_ex_smo, vq_ex_atr)
[ex_le_vx,  ex_se_vx ] = jcif.vortex_exit(vortex_ex_p)
[ex_le_wa,  ex_se_wa ] = jcif.waddah_attar_explosion_exit(wae_ex_sens, wae_ex_fast, wae_ex_slow, wae_ex_bbL, wae_ex_bbS)
[ex_le_ft, ex_se_ft] = jcif.fisher_transform_exit(ft_ex_len)
[ex_le_ar, ex_se_ar] = jcif.aroon_exit(aroon_ex_len)
[ex_le_mm, ex_se_mm] = jcif.mama_fama_exit(mama_ex_fast, mama_ex_slow)
[ex_le_cg, ex_se_cg] = jcif.center_of_gravity_exit(cog_ex_len, cog_ex_sig)
[ex_le_ks, ex_se_ks] = jcif.kuskus_starlight_exit(ks_ex_range, ks_ex_psm, ks_ex_ism)
[ex_le_bbi, ex_se_bbi] = jcif.bears_bulls_impulse_exit(bbi_ex_len)
[ex_le_fxs, ex_se_fxs] = jcif.fx_sniper_ergodic_cci_exit(fxs_ex_cci, fxs_ex_p1, fxs_ex_p2, fxs_ex_trig)
[ex_le_lmt, ex_se_lmt] = jcif.lemantrend_exit(lmt_ex_p1, lmt_ex_p2, lmt_ex_p3, lmt_ex_smooth)
[ex_le_gli, ex_se_gli] = jcif.glitch_index_exit(gli_ex_len, gli_ex_mult, gli_ex_smooth)
[ex_le_ere, ex_se_ere] = jcif.ehlers_reverse_ema_exit(ere_ex_len, ere_ex_alpha)

raw_le = false
raw_se = false
if IND_5_SLCT == "Chaikin Money Flow"
    raw_le := ex_le_cmf
    raw_se := ex_se_cmf
else if IND_5_SLCT == "Chandelier Exit"
    raw_le := ex_le_ce
    raw_se := ex_se_ce
else if IND_5_SLCT == "Coppock Curve"
    raw_le := ex_le_cc
    raw_se := ex_se_cc
else if IND_5_SLCT == "Coral"
    raw_le := ex_le_co
    raw_se := ex_se_co
else if IND_5_SLCT == "DiDi Index"
    raw_le := ex_le_di
    raw_se := ex_se_di
else if IND_5_SLCT == "Detrended Price Oscillator"
    raw_le := ex_le_dp
    raw_se := ex_se_dp
else if IND_5_SLCT == "Detrended Synthetic Price Oscillator"
    raw_le := ex_le_ds
    raw_se := ex_se_ds
else if IND_5_SLCT == "Ease Of Movement"
    raw_le := ex_le_eo
    raw_se := ex_se_eo
else if IND_5_SLCT == "Half Trend"
    raw_le := ex_le_ht
    raw_se := ex_se_ht
else if IND_5_SLCT == "Heiken Ashi Smoothed"
    raw_le := ex_le_ha
    raw_se := ex_se_ha
else if IND_5_SLCT == "J_TPO"
    raw_le := ex_le_jt
    raw_se := ex_se_jt
else if IND_5_SLCT == "Kallman Filter"
    raw_le := ex_le_kf
    raw_se := ex_se_kf
else if IND_5_SLCT == "Kase Peak Oscillator"
    raw_le := ex_le_kp
    raw_se := ex_se_kp
else if IND_5_SLCT == "Laguerre Filter"
    raw_le := ex_le_lf
    raw_se := ex_se_lf
else if IND_5_SLCT == "Price Momentum Oscillator"
    raw_le := ex_le_pmo
    raw_se := ex_se_pmo
else if IND_5_SLCT == "Polychrmatic Momentum"
    raw_le := ex_le_pm
    raw_se := ex_se_pm
else if IND_5_SLCT == "QQE Mod"
    raw_le := ex_le_qq
    raw_se := ex_se_qq
else if IND_5_SLCT == "Relative Vigor Index"
    raw_le := ex_le_rv
    raw_se := ex_se_rv
else if IND_5_SLCT == "Rex Oscillator"
    raw_le := ex_le_rx
    raw_se := ex_se_rx
else if IND_5_SLCT == "Schaff Trend Cycle"
    raw_le := ex_le_st
    raw_se := ex_se_st
else if IND_5_SLCT == "SSL Channel"
    raw_le := ex_le_ss
    raw_se := ex_se_ss
else if IND_5_SLCT == "Supertrend"
    raw_le := ex_le_su
    raw_se := ex_se_su
else if IND_5_SLCT == "Trend Direction Force Index"
    raw_le := ex_le_td
    raw_se := ex_se_td
else if IND_5_SLCT == "Volatility Quality"
    raw_le := ex_le_vq
    raw_se := ex_se_vq
else if IND_5_SLCT == "Vortex Indicator"
    raw_le := ex_le_vx
    raw_se := ex_se_vx
else if IND_5_SLCT == "Waddah Attar Explosion"
    raw_le := ex_le_wa
    raw_se := ex_se_wa
else if IND_5_SLCT == "Fisher Transform"
    raw_le := ex_le_ft
    raw_se := ex_se_ft
else if IND_5_SLCT == "Aroon"
    raw_le := ex_le_ar
    raw_se := ex_se_ar
else if IND_5_SLCT == "MAMA FAMA"
    raw_le := ex_le_mm
    raw_se := ex_se_mm
else if IND_5_SLCT == "Center of Gravity"
    raw_le := ex_le_cg
    raw_se := ex_se_cg
else if IND_5_SLCT == "Kuskus Starlight"
    raw_le := ex_le_ks
    raw_se := ex_se_ks
else if IND_5_SLCT == "Bears Bulls Impulse"
    raw_le := ex_le_bbi
    raw_se := ex_se_bbi
else if IND_5_SLCT == "FX Sniper Ergodic CCI"
    raw_le := ex_le_fxs
    raw_se := ex_se_fxs
else if IND_5_SLCT == "Lemantrend"
    raw_le := ex_le_lmt
    raw_se := ex_se_lmt
else if IND_5_SLCT == "Glitch Index"
    raw_le := ex_le_gli
    raw_se := ex_se_gli
else if IND_5_SLCT == "Ehlers Reverse EMA"
    raw_le := ex_le_ere
    raw_se := ex_se_ere

if Ind_5_Check_Exit
    Ind_5_L_Exit := raw_le and strategy.position_size > 0
    Ind_5_S_Exit := raw_se and strategy.position_size < 0

// ============================================================
// BASELINE
// ============================================================
float baseline = na
if maType == "HMA"
    baseline := jcif.moving_average("HMA", input.int(20, title="HMA: Length", group="HMA Settings As Baseline"))
if maType == "EMA"
    baseline := jcif.moving_average("EMA", input.int(20, title="EMA: Length", group="EMA Settings As Baseline"))
if maType == "RMA"
    baseline := jcif.moving_average("RMA", input.int(20, title="RMA: Length", group="RMA Settings As Baseline"))
if maType == "WMA"
    baseline := jcif.moving_average("WMA", input.int(20, title="WMA: Length", group="WMA Settings As Baseline"))
if maType == "VWMA"
    baseline := jcif.moving_average("VWMA", input.int(20, title="VWMA: Length", group="VWMA Settings As Baseline"))
if maType == "Fantail VMA"
    fv_adx = input.int(2, title="Fantail VMA: ADX Length", group="Fantail VMA Settings As Baseline")
    fv_len = input.float(10.0, title="Fantail VMA: Length", group="Fantail VMA Settings As Baseline")
    fv_l2  = input.int(6, title="Fantail VMA: Length", group="Fantail VMA Settings As Baseline")
    baseline := jcif.fantail_vma(fv_adx, fv_len, fv_l2)
if maType == "McGinley Dynamic Index"
    baseline := jcif.mcginley_dynamic_index(input.int(14, title="McGinley Dynamic Index: Length", group="McGinley Dynamic Index Settings As Baseline"))
if maType == "Triangular Moving Average"
    baseline := jcif.triangular_moving_average(input.int(20, title="Triangular Moving Average: Length", group="Triangular Moving Average Settings As Baseline"))
if maType == "VIDYA"
    vd_len = input.int(2, title="VIDYA: Length", group="VIDYA Settings As Baseline")
    vd_fix = input.bool(true, title="VIDYA: Fixed CMO Length", group="VIDYA Settings As Baseline")
    vd_alt = input.bool(true, title="VIDYA: Calculation Method: CMO/StDev", group="VIDYA Settings As Baseline")
    baseline := jcif.vidya(vd_len, vd_fix, vd_alt)
if maType == "KAMA"
    kama_len  = input.int(10, title="KAMA: Length",      group="KAMA Settings As Baseline")
    kama_fast = input.int(2,  title="KAMA: Fast Length", group="KAMA Settings As Baseline")
    kama_slow = input.int(30, title="KAMA: Slow Length", group="KAMA Settings As Baseline")
    baseline := jcif.kama_baseline(kama_len, kama_fast, kama_slow)
if maType == "ALMA"
    alma_len   = input.int(9,    title="ALMA: Length", group="ALMA Settings As Baseline")
    alma_off   = input.float(0.85, title="ALMA: Offset", group="ALMA Settings As Baseline")
    alma_sigma = input.int(6,    title="ALMA: Sigma",  group="ALMA Settings As Baseline")
    baseline := jcif.alma_baseline(alma_len, alma_off, alma_sigma)
if maType == "T3 Tillson"
    t3_len = input.int(10,   title="T3 Tillson: Length",  group="T3 Tillson Settings As Baseline")
    t3_vf  = input.float(0.7, title="T3 Tillson: V Factor", group="T3 Tillson Settings As Baseline")
    baseline := jcif.t3_baseline(t3_len, t3_vf)
if maType == "Super Smoother 2-Pole"
    ss_cut = input.int(15, title="Super Smoother: Cutoff Period", group="Super Smoother 2-Pole Settings As Baseline")
    baseline := jcif.super_smoother_2pole_baseline(ss_cut)
if maType == "FRAMA"
    frama_len = input.int(10, title="FRAMA: Length", group="FRAMA Settings As Baseline")
    baseline := jcif.frama_baseline(frama_len)

Ind_4_L_Conf = Ind_4_Check_Conf ? close > baseline : true
Ind_4_S_Conf = Ind_4_Check_Conf ? close < baseline : true

Ind_4_L_Trig = Ind_4_Check_Trig and ta.crossover(close, baseline)  and Ind_3_L_Conf and Ind_2_L_Conf and Ind_1_L_Conf
Ind_4_S_Trig = Ind_4_Check_Trig and ta.crossunder(close, baseline) and Ind_3_S_Conf and Ind_2_S_Conf and Ind_1_S_Conf

Ind_4_L_Conf_ATR = Ind_4_Check_Conf and NAU_ATR_Check_Conf ? close < baseline + ATR_VAR * atr : true
Ind_4_S_Conf_ATR = Ind_4_Check_Conf and NAU_ATR_Check_Conf ? close > baseline - ATR_VAR * atr : true

Ind_4_L_Exit = Ind_4_Check_Exit and ta.crossunder(close, baseline) and strategy.position_size > 0
Ind_4_S_Exit = Ind_4_Check_Exit and ta.crossover(close, baseline)  and strategy.position_size < 0

// ============================================================
// CONTINUATION TRADES + BRIDGE TOO FAR
// ============================================================
Count_CON = float(0.0)
Count_CON := ta.cross(close, baseline) ? 0 : strategy.position_size != 0 ? 1 : strategy.position_size[1] != 0 and strategy.position_size == 0 ? 2 : Count_CON[1]
Ind_CON_Trig = Ind_6_Check and Count_CON == 2

Count_BTF = float(0.0)
Count_BTF := ta.cross(close, baseline) ? 0 : Count_BTF[1] + 1
Ind_BTF_Conf = Ind_4_Check_Conf and NAU_BTF_Check_Conf ? Count_BTF <= BTF_VAR : true

// ============================================================
// POSITION SIZING
// ============================================================
var balance = startBalance
balance := compoundProfits ? startBalance + strategy.netprofit : startBalance

posSize = 0.0
if fixedpositionsize
    posSize := dollarsPC * contracts
else
    posSize := math.round(balance[1] * percentRisk / (atrMulti_Loss * atr))

// ============================================================
// ENTRY CONDITIONS (3 separate, each toggleable)
// ============================================================
longcondition1  = useBaselineEntry     and strategy.position_size <= 0 and Ind_1_L_Conf and Ind_2_L_Conf and Ind_3_L_Conf and (Ind_4_L_Trig or Ind_4_L_Trig[1] and NAU_OCR_Check_Conf) and Ind_4_L_Conf_ATR and Ind_BTF_Conf
shortcondition1 = useBaselineEntry     and strategy.position_size >= 0 and Ind_1_S_Conf and Ind_2_S_Conf and Ind_3_S_Conf and (Ind_4_S_Trig or Ind_4_S_Trig[1] and NAU_OCR_Check_Conf) and Ind_4_S_Conf_ATR and Ind_BTF_Conf
longcondition2  = useC1Entry           and strategy.position_size <= 0 and (Ind_1_L_Trigger or Ind_1_L_Trigger[1] and NAU_OCR_Check_Conf) and Ind_2_L_Conf and Ind_3_L_Conf and Ind_4_L_Conf and Ind_4_L_Conf_ATR and Ind_BTF_Conf
shortcondition2 = useC1Entry           and strategy.position_size >= 0 and (Ind_1_S_Trigger or Ind_1_S_Trigger[1] and NAU_OCR_Check_Conf) and Ind_2_S_Conf and Ind_3_S_Conf and Ind_4_S_Conf and Ind_4_S_Conf_ATR and Ind_BTF_Conf
longcondition3  = useContinuationEntry and strategy.position_size <= 0 and Ind_1_L_Trigger and Ind_2_L_Conf and Ind_3_L_Conf and Ind_4_L_Conf and Ind_4_L_Conf_ATR and Ind_CON_Trig
shortcondition3 = useContinuationEntry and strategy.position_size >= 0 and Ind_1_S_Trigger and Ind_2_S_Conf and Ind_3_S_Conf and Ind_4_S_Conf and Ind_4_S_Conf_ATR and Ind_CON_Trig

plotshape(longcondition1,  color=color.new(color.green,  75), style=shape.triangleup,   location=location.bottom, size=size.tiny)
plotshape(shortcondition1, color=color.new(color.green,  75), style=shape.triangledown, location=location.bottom, size=size.tiny)
plotshape(longcondition2,  color=color.new(color.purple, 75), style=shape.triangleup,   location=location.bottom, size=size.tiny)
plotshape(shortcondition2, color=color.new(color.purple, 75), style=shape.triangledown, location=location.bottom, size=size.tiny)
plotshape(longcondition3,  color=color.new(color.blue,   75), style=shape.triangleup,   location=location.bottom, size=size.tiny)
plotshape(shortcondition3, color=color.new(color.blue,   75), style=shape.triangledown, location=location.bottom, size=size.tiny)

entry_long  = (longcondition1  or longcondition2  or longcondition3 ) and dateWindow()
entry_short = (shortcondition1 or shortcondition2 or shortcondition3) and dateWindow() and shortrades

// ============================================================
// ORDER MANAGEMENT
// ============================================================
idLE1 = str.tostring(close - (atr*atrMulti_Loss))
idSE1 = str.tostring(close + (atr*atrMulti_Loss))
A_Lalert = l_AlertMSG + " " + syminfo.ticker
A_Salert = s_AlertMSG + " " + syminfo.ticker
A_Ealert = e_AlertMSG + " " + syminfo.ticker

if entry_long
    strategy.entry(id='Long Entry 1', comment=idLE1, direction=strategy.long, qty=doubletrades ? posSize * 0.5 : posSize)
    alert(A_Lalert, alert.freq_all)
if entry_long and doubletrades
    strategy.entry(id='Long Entry 2', comment=idLE1, direction=strategy.long, qty=posSize * 0.5)
if entry_short
    strategy.entry(id='Short Entry 1', comment=idSE1, direction=strategy.short, qty=doubletrades ? posSize * 0.5 : posSize)
    alert(A_Salert, alert.freq_all)
if entry_short and doubletrades
    strategy.entry(id='Short Entry 2', comment=idSE1, direction=strategy.short, qty=posSize * 0.5)

entry_atr   = float(0.0)
entry_price = float(0.0)
entry_atr   := strategy.position_size == 0 or entry_long or entry_short ? atr   : entry_atr[1]
entry_price := strategy.position_size == 0 or entry_long or entry_short ? close : entry_price[1]

nLoss   = entry_atr * atrMulti_Loss
nProfit = entry_atr * atrMulti_Profit

// ============================================================
// V5: NNFX PHASED — phase tracking + trail state
// ============================================================
// Phase 1: SL at entry +/- nLoss, no special handling
// Phase 2: SL at entry (breakeven), triggered when Leg 1 TP hits
// Phase 3: trailing SL at 1.5x ATR below highest close since activation,
//          triggered when price reaches 2x ATR profit from entry
//
// Phase tracking is per-trade. State is reset on new entry (entry_long /
// entry_short) and persists otherwise via prev-bar nz() reads. The
// activation gates check current bar's high/low against the entry-relative
// thresholds, since Pine fills SL/TP intrabar against high/low.

NNFX_TRAIL_ACTIVATION_MULT = 2.0  // price must reach entry +/- 2.0 * ATR-at-entry to activate trail
NNFX_TRAIL_DISTANCE_MULT   = 1.5  // trail sits 1.5 * current ATR below highest close (long) / above lowest close (short)

var int   nnfx_phase_long    = 0      // 0 = no position, 1 = Phase 1, 2 = Phase 2 (breakeven), 3 = Phase 3 (trail)
var int   nnfx_phase_short   = 0
var float nnfx_trail_high_long  = na  // highest close since trail (Phase 3) activated, long side
var float nnfx_trail_low_short  = na  // lowest close since trail activated, short side

// Reset phase state on new entry
if entry_long
    nnfx_phase_long := 1
    nnfx_trail_high_long := na
if entry_short
    nnfx_phase_short := 1
    nnfx_trail_low_short := na

// Phase progression for long side (only when in a long position)
if strategy.position_size > 0 and not entry_long
    leg1_tp_long_level = entry_price + nProfit
    trail_activation_long = entry_price + NNFX_TRAIL_ACTIVATION_MULT * entry_atr

    // Phase 1 -> 2: Leg 1 TP hit (price touched TP level intrabar)
    if nnfx_phase_long == 1 and high >= leg1_tp_long_level
        nnfx_phase_long := 2

    // Phase 2 -> 3: price reached 2x ATR profit (must be in Phase 2 first)
    if nnfx_phase_long == 2 and high >= trail_activation_long
        nnfx_phase_long := 3
        nnfx_trail_high_long := close  // seed trail tracker with current close

    // Update trail high while in Phase 3
    if nnfx_phase_long == 3
        nnfx_trail_high_long := math.max(close, nz(nnfx_trail_high_long, close))

// Phase progression for short side (mirror)
if strategy.position_size < 0 and not entry_short
    leg1_tp_short_level = entry_price - nProfit
    trail_activation_short = entry_price - NNFX_TRAIL_ACTIVATION_MULT * entry_atr

    if nnfx_phase_short == 1 and low <= leg1_tp_short_level
        nnfx_phase_short := 2

    if nnfx_phase_short == 2 and low <= trail_activation_short
        nnfx_phase_short := 3
        nnfx_trail_low_short := close

    if nnfx_phase_short == 3
        nnfx_trail_low_short := math.min(close, nz(nnfx_trail_low_short, close))

// Reset phase state when flat
if strategy.position_size == 0
    nnfx_phase_long  := 0
    nnfx_phase_short := 0
    nnfx_trail_high_long := na
    nnfx_trail_low_short := na

// ============================================================
// STOP / PROFIT LEVELS PER EXIT TYPE
// ============================================================
long_stop_level    = float(0.0)
long_profit_level  = float(0.0)
short_stop_level   = float(0.0)
short_profit_level = float(0.0)

// Leg-2-specific stops (only used by NNFX Phased and Static / Exit IND)
long_stop_level_leg2  = float(0.0)
short_stop_level_leg2 = float(0.0)

// ----- Static (unchanged from V3.2) -----
if Exit_Type == "Static"
    long_stop_level    := entry_price - nLoss
    long_profit_level  := entry_price + nProfit
    short_stop_level   := entry_price + nLoss
    short_profit_level := entry_price - nProfit
    long_stop_level_leg2  := long_stop_level
    short_stop_level_leg2 := short_stop_level

// ----- Static / Exit IND (V5: breakeven now hardcoded ON, no longer toggleable) -----
if Exit_Type == "Static / Exit IND"
    // Leg 1: always fixed SL + TP
    long_stop_level   := entry_price - nLoss
    long_profit_level := entry_price + nProfit
    short_stop_level  := entry_price + nLoss
    short_profit_level := entry_price - nProfit
    // Leg 2: breakeven move when Leg 1 closes (strategy.opentrades drops from 2 to 1)
    long_stop_level_leg2  := strategy.opentrades == 2 ? entry_price - nLoss : strategy.opentrades == 1 ? entry_price : na
    short_stop_level_leg2 := strategy.opentrades == 2 ? entry_price + nLoss : strategy.opentrades == 1 ? entry_price : na

// ----- NNFX Phased (V5: NEW) -----
if Exit_Type == "NNFX Phased"
    // Leg 1: always fixed SL + TP
    long_stop_level    := entry_price - nLoss
    long_profit_level  := entry_price + nProfit
    short_stop_level   := entry_price + nLoss
    short_profit_level := entry_price - nProfit

    // Leg 2 by phase
    if nnfx_phase_long == 1
        long_stop_level_leg2 := entry_price - nLoss
    else if nnfx_phase_long == 2
        long_stop_level_leg2 := entry_price
    else if nnfx_phase_long == 3
        long_stop_level_leg2 := math.max(nz(nnfx_trail_high_long, close) - NNFX_TRAIL_DISTANCE_MULT * atr, nz(long_stop_level_leg2[1], entry_price))
    else
        long_stop_level_leg2 := na

    if nnfx_phase_short == 1
        short_stop_level_leg2 := entry_price + nLoss
    else if nnfx_phase_short == 2
        short_stop_level_leg2 := entry_price
    else if nnfx_phase_short == 3
        short_stop_level_leg2 := math.min(nz(nnfx_trail_low_short, close) + NNFX_TRAIL_DISTANCE_MULT * atr, nz(short_stop_level_leg2[1], entry_price))
    else
        short_stop_level_leg2 := na

// ============================================================
// PLOT STOPS & PROFIT LINES
// ============================================================
entryprice1 = plot(strategy.position_size != 0 or entry_long or entry_short ? entry_price : na, color=color.new(color.white, 0), style=plot.style_linebr, linewidth=2)
longstop    = plot(strategy.position_size <= 0 or entry_long or entry_short ? na : long_stop_level,   color=color.new(color.red,  100), style=plot.style_linebr, linewidth=2)
longprofit  = plot(strategy.position_size <= 0 or entry_long or entry_short ? na : long_profit_level, color=color.new(color.lime, 100), style=plot.style_linebr, linewidth=2)
shortstop   = plot(strategy.position_size >= 0 or entry_long or entry_short ? na : short_stop_level,  color=color.new(color.red,  100), style=plot.style_linebr, linewidth=2)
shortprofit = plot(strategy.position_size >= 0 or entry_long or entry_short ? na : short_profit_level,color=color.new(color.lime, 100), style=plot.style_linebr, linewidth=2)
fill(entryprice1, longstop,    color=color.new(color.red,  50))
fill(entryprice1, longprofit,  color=color.new(color.lime, 50))
fill(entryprice1, shortstop,   color=color.new(color.red,  50))
fill(entryprice1, shortprofit, color=color.new(color.lime, 50))

// ============================================================
// EXIT ORDERS
// ============================================================
if Exit_Type == "Static"
    strategy.exit("SL/TP 1", "Long Entry 1",  stop=long_stop_level,  limit=long_profit_level)
    strategy.exit("SL/TP 1", "Short Entry 1", stop=short_stop_level, limit=short_profit_level)
    strategy.exit("SL/TP 2", "Long Entry 2",  stop=long_stop_level_leg2,  limit=long_profit_level)
    strategy.exit("SL/TP 2", "Short Entry 2", stop=short_stop_level_leg2, limit=short_profit_level)
if Exit_Type == "Static / Exit IND"
    strategy.exit("SL/TP 1", "Long Entry 1",  stop=long_stop_level,  limit=long_profit_level)
    strategy.exit("SL/TP 1", "Short Entry 1", stop=short_stop_level, limit=short_profit_level)
    strategy.exit("SL 2",    "Long Entry 2",  stop=long_stop_level_leg2,  limit=na)
    strategy.exit("SL 2",    "Short Entry 2", stop=short_stop_level_leg2, limit=na)
if Exit_Type == "NNFX Phased"
    strategy.exit("SL/TP 1", "Long Entry 1",  stop=long_stop_level,  limit=long_profit_level)
    strategy.exit("SL/TP 1", "Short Entry 1", stop=short_stop_level, limit=short_profit_level)
    strategy.exit("SL 2",    "Long Entry 2",  stop=long_stop_level_leg2,  limit=na)
    strategy.exit("SL 2",    "Short Entry 2", stop=short_stop_level_leg2, limit=na)

// Exit indicator (Slot 5) closes BOTH legs — applies to Static / Exit IND and NNFX Phased
if Exit_Type == "Static / Exit IND" or Exit_Type == "NNFX Phased"
    if Ind_5_L_Exit
        strategy.close(id="Long Entry 1",  comment="Exit Long 1")
        strategy.close(id="Long Entry 2",  comment="Exit Long 2")
        alert(A_Ealert, alert.freq_all)
    if Ind_5_S_Exit
        strategy.close(id="Short Entry 1", comment="Exit Short 1")
        strategy.close(id="Short Entry 2", comment="Exit Short 2")
        alert(A_Ealert, alert.freq_all)
    if Ind_4_L_Exit
        strategy.close(id="Long Entry 1",  comment="BL Exit Long 1")
        strategy.close(id="Long Entry 2",  comment="BL Exit Long 2")
        alert(A_Ealert, alert.freq_all)
    if Ind_4_S_Exit
        strategy.close(id="Short Entry 1", comment="BL Exit Short 1")
        strategy.close(id="Short Entry 2", comment="BL Exit Short 2")
        alert(A_Ealert, alert.freq_all)

// Main C1 flip exit — independent of Exit_Type, applies whenever iMainindExit is on
if iMainindExit and strategy.position_size > 0 and Ind_1_S_Trigger
    strategy.close(id="Long Entry 1",  comment="Exit Long 1")
    strategy.close(id="Long Entry 2",  comment="Exit Long 2")
    alert(A_Ealert, alert.freq_all)
if iMainindExit and strategy.position_size < 0 and Ind_1_L_Trigger
    strategy.close(id="Short Entry 1", comment="Exit Short 1")
    strategy.close(id="Short Entry 2", comment="Exit Short 2")
    alert(A_Ealert, alert.freq_all)

// ============================================================
// STATS TABLES (unchanged from V3.2)
// ============================================================
theme_color = color_theme1
txt_color   = Text_color1
bgcolor     = BckGRnd_color1

reward = 0.0
risk   = 0.0
if strategy.wintrades != strategy.wintrades[1]
    reward := (math.abs((strategy.closedtrades.entry_price(strategy.closedtrades - 1)) - (strategy.closedtrades.exit_price(strategy.closedtrades - 1))) * strategy.closedtrades.size(strategy.closedtrades - 1)) / balance[1]
if strategy.losstrades != strategy.losstrades[1]
    risk := (math.abs((strategy.closedtrades.entry_price(strategy.closedtrades - 1)) - (strategy.closedtrades.exit_price(strategy.closedtrades - 1))) * strategy.closedtrades.size(strategy.closedtrades - 1)) / balance[1]

totalWins   = strategy.wintrades
totalLoss   = strategy.losstrades
totaltrades = strategy.closedtrades
BarsIT      = (strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)) - (strategy.closedtrades.entry_bar_index(strategy.closedtrades - 1))

var Bars_intrade = array.new_int(totaltrades)
array.push(Bars_intrade, BarsIT)
AbarsIT = array.avg(Bars_intrade)

ProfitF    = strategy.grossprofit / strategy.grossloss
Expectancy = (strategy.netprofit / startBalance) / totaltrades
AVGwin     = ((strategy.grossprofit / totalWins) / startBalance) * 100
AVGloss    = ((strategy.grossloss   / totalLoss) / startBalance) * 100

ms_per_year = 365.25 * 24 * 60 * 60 * 1000
ms_total    = timestamp(syminfo.timezone, endYear, endMonth, endDate, 0, 0) - timestamp(syminfo.timezone, startYear, startMonth, startDate, 0, 0)
totalyears  = ms_total / ms_per_year

totalCagr = totalyears > 0 and balance > 0 and startBalance > 0 ? math.pow(balance / startBalance, 1/totalyears) - 1 : 0.0

var table testTable = table.new(position.middle_right, 10, 10, frame_color=theme_color, frame_width=2, border_color=theme_color, border_width=2)
f_fillCell(_table, _column, _row, _title, _value, _bgcolor, _txtcolor) =>
    _cellText = _title + "\n" + _value
    table.cell(_table, _column, _row, _cellText, bgcolor=_bgcolor, text_color=_txtcolor)

if drawtester and ChartMode == "Backtesting"
    if barstate.islastconfirmedhistory
        f_fillCell(testTable, 0, 0, "Total Trades:",  str.tostring(strategy.closedtrades), bgcolor, txt_color)
        f_fillCell(testTable, 1, 0, "Win Rate:",      str.tostring(truncate((strategy.wintrades/strategy.closedtrades)*100, 2)) + "%", bgcolor, txt_color)
        f_fillCell(testTable, 0, 1, "Profit Factor",  str.tostring(truncate(ProfitF, 4)),  bgcolor, ProfitF > 1 ? color.green : color.red)
        f_fillCell(testTable, 1, 1, "Expectancy",     str.tostring(truncate(Expectancy*100, 4)) + " %", bgcolor, Expectancy > 0 ? color.green : color.red)
        f_fillCell(testTable, 0, 2, "Average Win:",   str.tostring(truncate(AVGwin, 4))  + " %", bgcolor, color.green)
        f_fillCell(testTable, 1, 2, "Average Loss:",  str.tostring(truncate(AVGloss, 4)) + " %", bgcolor, color.red)
        f_fillCell(testTable, 0, 3, "R:R:",           str.tostring(truncate(AVGwin/AVGloss, 4)),  bgcolor, ProfitF > 1 ? color.green : color.red)
        f_fillCell(testTable, 1, 3, "Average Bars In Trade:", str.tostring(math.round(AbarsIT)), bgcolor, txt_color)
        f_fillCell(testTable, 0, 4, "CAGR",           str.tostring(truncate(totalCagr*100, 2)) + " %", bgcolor, totalCagr > 0 ? color.green : color.red)
        f_fillCell(testTable, 1, 4, "Years Tested",   str.tostring(truncate(totalyears, 2)),     bgcolor, txt_color)

// Live trading table
INDA_Color = color.black
if (Ind_1_L_Conf and Ind_2_L_Conf and Ind_3_L_Conf and Ind_4_L_Conf) or (Ind_1_S_Conf and Ind_2_S_Conf and Ind_3_S_Conf and Ind_4_S_Conf)
    INDA_Color := color.gray

B_Atr = math.abs(close - baseline)
B_ATRcolor = B_Atr > (ATR_VAR*atr) ? color.red : color.green
C_BTF = Count_BTF > BTF_VAR ? color.red : color.green

string T_SL    = na
string T_TP    = na
string T_IND1  = Ind_1_L_Conf ? "Long" : "Short"
string T_IND2  = Ind_2_L_Conf ? "Long" : "Short"
string T_IND3  = Ind_3_L_Conf ? "True" : "False"
string T_IND4  = Ind_4_L_Conf ? "Long" : "Short"
string T_PositionS = "No Position"
string T_PositionE = "Maintain Positions"
string T_IND1Entry = "No Entry Signal"
string T_AccoB     = "$ " + str.tostring(truncate(balance, 2))
string T_PosSZ     = str.tostring(posSize)
string T_BTF       = str.tostring(Count_BTF)
string T_AtrD      = str.tostring(truncate(B_Atr, 4))

if strategy.opentrades == 1
    T_PositionS := "1"
if strategy.opentrades == 2
    T_PositionS := "2"

EX_color = color.gray
if Ind_5_L_Exit or Ind_5_S_Exit
    T_PositionE := "Exit Positions"
    EX_color := color.red

E_color = color.gray
if entry_long
    T_IND1Entry := "Enter Long"
    E_color := color.green
if entry_short
    T_IND1Entry := "Enter Short"
    E_color := color.green

T_LsLoss = close - (atr*atrMulti_Loss)
T_SsLoss = close + (atr*atrMulti_Loss)
T_LTP    = close + (atr*atrMulti_Profit)
T_STP    = close - (atr*atrMulti_Profit)

T_SL := Ind_1_L_Conf ? str.tostring(truncate(T_LsLoss, 4)) : Ind_1_S_Conf ? str.tostring(truncate(T_SsLoss, 4)) : na
T_TP := Ind_1_L_Conf ? str.tostring(truncate(T_LTP, 4))    : Ind_1_S_Conf ? str.tostring(truncate(T_STP, 4))    : na

string indicator1 = IND_1_SLCT
string indicator2 = IND_2_SLCT
string indicator3 = IND_3_SLCT
string indicator4 = maType
string indicator5 = IND_5_SLCT

var table testTable1 = table.new(position.top_right, 2, 14, frame_color=theme_color, frame_width=2, border_color=theme_color, border_width=2)
f_fillCell1(_table, _column, _row, _value, _bgcolor, _txtcolor, _txtSize) =>
    table.cell(_table, _column, _row, _value, bgcolor=_bgcolor, text_color=_txtcolor, text_size=_txtSize)

if P_ltc and ChartMode == "Live Trading"
    if barstate.islastconfirmedhistory
        f_fillCell1(testTable1, 0,  0, "Stop Loss",            bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  0, T_SL,                   bgcolor, color.red, size.small)
        f_fillCell1(testTable1, 0,  1, "Profit Target",        bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  1, T_TP,                   bgcolor, color.green, size.small)
        f_fillCell1(testTable1, 0,  2, indicator1 + " Bias: ", bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  2, T_IND1,                 bgcolor, Ind_1_L_Conf ? color.green : color.red, size.small)
        f_fillCell1(testTable1, 0,  3, indicator2 + " Bias: ", bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  3, T_IND2,                 bgcolor, Ind_2_L_Conf ? color.green : color.red, size.small)
        f_fillCell1(testTable1, 0,  4, indicator3 + " Bias",   bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  4, T_IND3,                 bgcolor, Ind_3_L_Conf ? color.green : color.red, size.small)
        f_fillCell1(testTable1, 0,  5, indicator4 + " Bias: ", bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  5, T_IND4,                 bgcolor, Ind_4_L_Conf ? color.green : color.red, size.small)
        f_fillCell1(testTable1, 0,  6, "Open Positions",       bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  6, T_PositionS,            bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 0,  7, "Entry Signal",         bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  7, T_IND1Entry,            E_color, color.black, size.small)
        f_fillCell1(testTable1, 0,  8, "Exit Signal",          bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  8, T_PositionE,            EX_color, color.black, size.small)
        f_fillCell1(testTable1, 0,  9, "Account Balance",      bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1,  9, T_AccoB,                bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 0, 10, "Contracts",            bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1, 10, T_PosSZ,                bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 0, 11, "BTF Count",            bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1, 11, T_BTF,                  bgcolor, C_BTF, size.small)
        f_fillCell1(testTable1, 0, 12, "Distance From BL",     bgcolor, txt_color, size.small)
        f_fillCell1(testTable1, 1, 12, T_AtrD,                 bgcolor, B_ATRcolor, size.small)
