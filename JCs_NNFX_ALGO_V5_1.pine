ha_c1_t2 = input.string(defval="T3", title="HeikenAshi Smoothed: Type of second moving average", options=["TRIMA","VIDYA","FAMA","AMA","HMA","TEMA","SMMA","WMA","EMA","SMA","T3","DEMA","ALMA","LSMA"], group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
ha_c1_l2 = input.int(8, title="HeikenAshi Smoothed: Length of Second Moving Average", group="[C1] Heiken Ashi Smoothed", active=(IND_1_SLCT == "Heiken Ashi Smoothed"))
